#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
if [[ -n "${LUCID_MEMORIES_ROOT:-}" ]]; then
  ROOT="$LUCID_MEMORIES_ROOT"
elif [[ -d "$SCRIPT_DIR/../src/lucid_memories" ]]; then
  ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
else
  ROOT="$HOME/.cursor/lucid-memories"
fi

PY=""
for candidate in \
  "$HOME/AppData/Local/Python/pythoncore-3.14-64/python.exe" \
  "$HOME/AppData/Local/Python/bin/python.exe" \
  python \
  python3
do
  if [[ -x "$candidate" ]] || command -v "$candidate" >/dev/null 2>&1; then
    PY="$candidate"
    break
  fi
done
if [[ -z "$PY" ]]; then
  echo '{"ok":false,"error":"python not found"}' >&2
  exit 1
fi

export PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONUTF8=1
export PYTHONIOENCODING=utf-8
exec "$PY" -m lucid_memories.web.dashboard "$@"
